FROM node:22-alpine

# Install headless Java (no GUI / desktop dependencies)
RUN apk add --no-cache openjdk21-jre-headless bash && \
    npm install -g --no-audit --no-fund firebase-tools && \
    npm cache clean --force

WORKDIR /app
COPY firebase.json ./

EXPOSE 8080 9099 4000

CMD ["firebase", "emulators:start", "--project=demo-portfolio"]

